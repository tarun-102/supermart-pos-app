# ==================================
# ShiftFlow - Root Git Ignore
# Covers Backend and Froentend
# ==================================

# Node modules (both folders)
**/node_modules/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example

# Build folders
**/dist/
**/build/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend generated files
**/.vite/
**/.next/
**/coverage/

# Backend uploads and temporary files
**/public/temp/
**/uploads/temp/
**/temp/

# Testing
**/.nyc_output/

# Editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local deployment settings
.vercel/
.render/